{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ════════════════════════════════════════════════════════════
  // ⬇️ CHANGE THIS: Your worker name (e.g., "clientname-landing").
  // Change WORKER_SELF_REFERENCE below to the same name.
  // ════════════════════════════════════════════════════════════
  "name": "sample-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Deploy Buttons normally detect the package.json deploy script. This build
  // hook also makes Cloudflare's default `npx wrangler deploy` path safe: the
  // OpenNext Worker is generated before Wrangler reads the entry point.
  "build": {
    "command": "pnpm exec opennextjs-cloudflare build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // ════════════════════════════════════════════════════════════
  // CACHE (see open-next.config.ts). Pages are built once and served
  // from R2; Sapt's webhook and each page's `revalidate` rebuild them.
  // The Deploy Button creates the bucket. The Durable Objects live in
  // this Worker, so there is nothing else to create.
  // ════════════════════════════════════════════════════════════
  "services": [
    // Must name this Worker: the queue rebuilds pages by calling it.
    { "binding": "WORKER_SELF_REFERENCE", "service": "sample-website" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "sample-website-cache" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }
  ]
  // ════════════════════════════════════════════════════════════
  // SECRET: APP_KEY lets Sapt's webhook rebuild pages the moment
  // content is published. Same value Sapt signs with:
  //   pnpm wrangler secret put APP_KEY
  // Without it an edit still shows, within about ten minutes.
  //
  // OPTIONAL: Bind a custom domain/subdomain. With Workers Builds
  // or `wrangler deploy` you can instead attach a route in the
  // Cloudflare dashboard. Example:
  //
  // "routes": [
  //   { "pattern": "clientname.example.com/*", "zone_id": "<your-zone-id>" }
  // ]
  // ════════════════════════════════════════════════════════════
}
