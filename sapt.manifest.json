{
  "$comment": "Structures this template needs. On Initialize, the Sapt platform reads this and provisions them into the client's project (idempotent). Edit here to change what a new client gets. The site itself is code-driven, so nothing here seeds page copy.",
  "objectTypes": [
    {
      "slug": "booking",
      "name": "Booking",
      "description": "Leads from the funnel and feedback from the review flow. Public-ingestable; links to a Person by email/phone. Every field the site posts is declared here so it lands as a real column a workflow can branch on, not as a pending field.",
      "icon": "CalendarCheck",
      "color": "#948cc1",
      "isPublicIngestable": true,
      "linksToPerson": true,
      "schema": {
        "name": {
          "label": "Name",
          "schema": {
            "type": "string",
            "options": {},
            "required": true
          }
        },
        "email": {
          "label": "Email",
          "schema": {
            "type": "string",
            "options": {
              "format": "email"
            }
          }
        },
        "phone": {
          "label": "Phone",
          "schema": {
            "type": "string",
            "options": {
              "format": "phone"
            }
          }
        },
        "vehicle": {
          "label": "Vehicle",
          "schema": {
            "type": "string",
            "options": {}
          },
          "description": "Year, make and model as the customer typed it."
        },
        "issue": {
          "label": "Issue",
          "schema": {
            "type": "select",
            "options": {
              "choices": [
                {
                  "id": "warning_light",
                  "slug": "warning_light",
                  "label": "Warning light"
                },
                {
                  "id": "brakes",
                  "slug": "brakes",
                  "label": "Brakes"
                },
                {
                  "id": "noise",
                  "slug": "noise",
                  "label": "Noise or vibration"
                },
                {
                  "id": "wont_start",
                  "slug": "wont_start",
                  "label": "Will not start"
                },
                {
                  "id": "maintenance",
                  "slug": "maintenance",
                  "label": "Routine maintenance"
                },
                {
                  "id": "not_sure",
                  "slug": "not_sure",
                  "label": "Not sure"
                }
              ]
            }
          },
          "description": "Mirrors the funnel step ids exactly. Change one and you must change the other."
        },
        "timing": {
          "label": "Timing",
          "schema": {
            "type": "select",
            "options": {
              "choices": [
                {
                  "id": "today",
                  "slug": "today",
                  "label": "Today"
                },
                {
                  "id": "this_week",
                  "slug": "this_week",
                  "label": "This week"
                },
                {
                  "id": "flexible",
                  "slug": "flexible",
                  "label": "Flexible"
                }
              ]
            }
          },
          "description": "How soon they need it in. Drives which lead gets called first."
        },
        "service": {
          "label": "Service",
          "schema": {
            "type": "string",
            "options": {}
          },
          "description": "Human-readable label for what they picked."
        },
        "status": {
          "label": "Status",
          "schema": {
            "type": "select",
            "options": {
              "choices": [
                {
                  "id": "new",
                  "slug": "new",
                  "label": "New"
                },
                {
                  "id": "contacted",
                  "slug": "contacted",
                  "label": "Contacted"
                },
                {
                  "id": "booked",
                  "slug": "booked",
                  "label": "Booked"
                },
                {
                  "id": "in_shop",
                  "slug": "in_shop",
                  "label": "In the shop"
                },
                {
                  "id": "completed",
                  "slug": "completed",
                  "label": "Completed"
                },
                {
                  "id": "lost",
                  "slug": "lost",
                  "label": "Lost"
                }
              ]
            }
          },
          "description": "A shop pipeline, not a generic one. Records land on `new`."
        },
        "source": {
          "label": "Source",
          "schema": {
            "type": "select",
            "options": {
              "choices": [
                {
                  "id": "booking_funnel",
                  "slug": "booking_funnel",
                  "label": "Website funnel"
                },
                {
                  "id": "feedback",
                  "slug": "feedback",
                  "label": "Review feedback"
                },
                {
                  "id": "phone",
                  "slug": "phone",
                  "label": "Phone"
                },
                {
                  "id": "walk_in",
                  "slug": "walk_in",
                  "label": "Walk-in"
                }
              ]
            }
          },
          "description": "`feedback` rows come from a customer who rated below the review threshold. They are service recovery, not leads, and should not be counted as one."
        },
        "rating": {
          "label": "Rating",
          "schema": {
            "type": "number",
            "options": {}
          },
          "description": "Only on `feedback` rows: the stars they gave before being asked what went wrong."
        },
        "preferredDate": {
          "label": "Preferred date",
          "schema": {
            "type": "string",
            "options": {}
          }
        },
        "preferredTime": {
          "label": "Preferred time",
          "schema": {
            "type": "string",
            "options": {}
          }
        },
        "saptVisitorId": {
          "label": "Sapt visitor id",
          "schema": {
            "type": "string",
            "options": {}
          },
          "description": "Ties the lead back to its first-party session."
        },
        "answers": {
          "label": "Answers (JSON)",
          "schema": {
            "type": "string",
            "options": {
              "format": "long-text"
            }
          },
          "description": "Raw funnel answers. The ones worth reporting on are promoted to real fields above."
        }
      }
    }
  ],
  "branding": {
    "description": "Clean, sharp, trustworthy aesthetic for an independent auto repair shop.",
    "keywords": [
      "clean",
      "sharp",
      "trustworthy"
    ],
    "fontStyleCategory": "modern",
    "colors": [
      {
        "name": "Primary",
        "hex": "#C8102E",
        "purpose": "primary"
      },
      {
        "name": "Accent",
        "hex": "#1D4ED8",
        "purpose": "accent"
      },
      {
        "name": "Background",
        "hex": "#FAFAFA",
        "purpose": "background"
      },
      {
        "name": "Text",
        "hex": "#1F2937",
        "purpose": "text"
      }
    ],
    "fonts": [
      {
        "id": "inter",
        "name": "Inter",
        "type": "primary",
        "source": "google",
        "googleFontFamily": "Inter",
        "weights": [
          400,
          500,
          600,
          700
        ]
      }
    ]
  }
}
