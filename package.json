{
  "name": "sapt-funnel-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "next dev --turbopack -p 2001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "init-project": "tsx scripts/init-project.ts",
    "pull-gbp": "tsx scripts/pull-gbp.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "15.4.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.2.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.8",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4"
  },
  "cloudflare": {
    "bindings": {
      "NEXT_PUBLIC_SAPT_PROJECT_ID": {
        "description": "Copy the Project ID from **Project Settings → Funnel** in [Sapt](https://app.sapt.ai/project-settings?tab=funnel). This identifier is public and connects analytics and lead capture to the correct project."
      }
    }
  }
}
