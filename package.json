{
  "name": "sapt-funnel-template",
  "version": "0.1.0",
  "description": "Cloudflare-first funnel template integrated with Sapt CRM, memory, and analytics.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapt-ai-org/funnel-template.git"
  },
  "homepage": "https://github.com/sapt-ai-org/funnel-template#readme",
  "bugs": {
    "url": "https://github.com/sapt-ai-org/funnel-template/issues"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:vite": "vite --host 0.0.0.0",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "startup:check": "wrangler check startup",
    "production:test": "pnpm check && pnpm deploy:dry-run",
    "smoke:test": "node scripts/production-smoke.mjs"
  },
  "cloudflare": {
    "bindings": {
      "SAPT_API_KEY": {
        "description": "Sapt API key. Create one in app.sapt.ai -> Account -> API Keys. Must have write access to SAPT_PROJECT_ID."
      },
      "SAPT_PROJECT_ID": {
        "description": "Sapt project ID where funnel leads, memory, and analytics should be stored."
      }
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "hono": "^4.6.14",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
